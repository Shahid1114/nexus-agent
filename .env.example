# ─── REQUIRED ───────────────────────────────────────────────
# Your PostgreSQL connection string.
# Get a FREE one from https://neon.tech (recommended) or https://supabase.com
# It looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ─── OPTIONAL (makes Nexus much smarter) ────────────────────
# Add an OpenAI key to upgrade Nexus to real GPT-4 quality.
# Get one at https://platform.openai.com/api-keys
# If left empty, Nexus uses its built-in engine and still works.
OPENAI_API_KEY=
